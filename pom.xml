<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.pigpurchases</groupId>
    <artifactId>pig-purchases</artifactId>
    <version>1.0-SNAPSHOT</version>
    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- Text extraction from PDF statements for the ingest parsers. -->
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <!-- Categorizes the transactions the deterministic matcher can't
                 resolve. Only descriptions and vendor names are ever sent;
                 amounts, balances, and account details never leave the machine. -->
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.50.0</version>
        </dependency>
        <dependency>
            <!-- Enables the in-app "Restart" button and auto-reload of
                 recompiled classes when running via spring-boot:run. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Runs the frontend's pure functions (static/app-math.js) inside JUnit, so the
                 money and date logic the browser uses is covered by `mvnw test` like
                 everything else. Test scope only: nothing ships, the page is still served as
                 a plain static file, and editing it still needs no build. -->
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>24.1.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js-community</artifactId>
            <version>24.1.1</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!--
                Javadoc, on demand: `mvnw javadoc:javadoc` -> target/reports/apidocs.
                Deliberately not bound to a lifecycle phase, for the same reason the
                architecture PDF is not: it is 220 files nobody needs during a test run.

                doclint is left ON for HTML and syntax, and off only for missing tags.
                That is not a cosmetic setting. The HTML check is what flagged a bare
                '&' and a '<-' in two parser javadocs, and following those two errors
                is how a real card payment amount was found sitting in a comment. The
                missing-tag warnings are the ~40 record components whose names are
                already their documentation, so leaving those on would bury the checks
                that earn their keep.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.3</version>
                <configuration>
                    <!-- Output path is left at the plugin's default rather than pinned.
                         It has moved before (target/site/apidocs -> target/reports/apidocs)
                         and overriding it here did not take effect for the CLI goal anyway;
                         javadoc.cmd locates the generated index instead, which is honest
                         about the path being the plugin's business rather than ours. -->
                    <doclint>all,-missing</doclint>
                    <notimestamp>true</notimestamp>
                    <quiet>true</quiet>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        Parsers written against real personal statements are maintained in a SEPARATE,
        PRIVATE repository, checked out beside this one:

            code/
            ├── PigPurchases/                     (this, public)
            └── pigpurchases-private-parsers/     (private)

        When that directory is present its sources are compiled as part of this build, so
        the parsers and their validation tests are edited and run in place. When it is
        absent — which is every clone but the author's — the profile never activates and
        the build is unaffected.

        The parsers here in src/main are demonstration parsers for generated sample
        statements. Both sets register through StatementParserRegistry; nothing in the
        ingest path knows which is which.

        A sibling rather than a subdirectory on purpose: nested, the whole arrangement
        would rest on one .gitignore line, and mistyping it starts staging private files
        into a public repository.
    -->
    <profiles>
        <profile>
            <id>private-parsers</id>
            <activation>
                <file>
                    <exists>${basedir}/../pigpurchases-private-parsers/src/main/java</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-private-parser-sources</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${basedir}/../pigpurchases-private-parsers/src/main/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-private-parser-tests</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${basedir}/../pigpurchases-private-parsers/src/test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
