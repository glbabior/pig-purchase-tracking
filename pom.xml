<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.pigpurchases</groupId>
    <artifactId>pig-purchases</artifactId>
    <version>1.0-SNAPSHOT</version>
    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- Text extraction from PDF statements for the ingest parsers. -->
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <!-- Categorizes the transactions the deterministic matcher can't
                 resolve. Only descriptions and vendor names are ever sent;
                 amounts, balances, and account details never leave the machine. -->
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.50.0</version>
        </dependency>
        <dependency>
            <!-- Enables the in-app "Restart" button and auto-reload of
                 recompiled classes when running via spring-boot:run. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Runs the frontend's pure functions (static/app-math.js) inside JUnit, so the
                 money and date logic the browser uses is covered by `mvnw test` like
                 everything else. Test scope only: nothing ships, the page is still served as
                 a plain static file, and editing it still needs no build. -->
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>24.1.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js-community</artifactId>
            <version>24.1.1</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!--
                Javadoc, on demand: `mvnw javadoc:javadoc` -> target/reports/apidocs.
                Deliberately not bound to a lifecycle phase, for the same reason the
                architecture PDF is not: it is 220 files nobody needs during a test run.

                doclint is left ON for HTML and syntax, and off only for missing tags.
                That is not a cosmetic setting. The HTML check is what flagged a bare
                '&' and a '<-' in two parser javadocs, and following those two errors
                is how a real card payment amount was found sitting in a comment. The
                missing-tag warnings are the ~40 record components whose names are
                already their documentation, so leaving those on would bury the checks
                that earn their keep.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.3</version>
                <configuration>
                    <!-- Output path is left at the plugin's default rather than pinned.
                         It has moved before (target/site/apidocs -> target/reports/apidocs)
                         and overriding it here did not take effect for the CLI goal anyway;
                         javadoc.cmd locates the generated index instead, which is honest
                         about the path being the plugin's business rather than ours. -->
                    <doclint>all,-missing</doclint>
                    <notimestamp>true</notimestamp>
                    <quiet>true</quiet>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        Statement parsers can live OUTSIDE this repository.

        The parsers here in src/main are demonstration parsers, written against invented
        formats so that this project can be cloned and run by someone who has none of its
        author's data. Parsers for real statements are a different matter: a parser is its
        issuer, since the product names in its regexes identify the account whatever the
        class is called. Those are maintained in a separate private repository.

        Set the parsers.dir property to a source tree laid out like this one and its
        src/main/java and src/test/java are compiled alongside these, so external parsers
        and their tests are edited and run in place with no install step. Set it once in
        ~/.m2/settings.xml and it applies to every build on that machine:

            <profile>
              <id>local-parsers</id>
              <properties><parsers.dir>D:/path/to/my-parsers</parsers.dir></properties>
            </profile>

        Where the property is undefined, which is every machine but the author's, the
        profile never activates and the build is unaffected. Nothing lists the parsers
        anywhere either way: StatementParserRegistry discovers them as beans and indexes
        them by the ids they declare.

        Deliberately a property rather than a conventional directory beside this one. A
        path in the pom would be a path of the author's, published in a public repository,
        which is most of what this arrangement exists to avoid.
    -->
    <profiles>
        <profile>
            <id>external-parsers</id>
            <activation>
                <property><name>parsers.dir</name></property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-private-parser-sources</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${parsers.dir}/src/main/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-private-parser-tests</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${parsers.dir}/src/test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
