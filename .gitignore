# Build output
target/

# Bundled Maven distribution & downloaded archive (not source)
maven/
apache-maven.zip

# Python virtual environment (helper scripts only)
.venv/

# H2 database — contains your local financial data, never commit
*.mv.db
*.trace.db
*.lock.db

# Local personal budget data — your amounts stay off git
pig-purchases-data.txt
pig-purchases-data.txt.imported
budget-import.json

# OS / shortcut noise
*.lnk

# Recovered DB candidates and any local db working folder — never commit financial data
/db/

# JVM crash dumps (native OOM etc.) — noise, never source
hs_err_pid*.log
replay_pid*.log

# Subagent reports — overwritten each run, superseded by the next one.
# The agent DEFINITIONS in .claude/agents/ are project config and DO get committed.
.claude/reports/
