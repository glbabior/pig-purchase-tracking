# Build output
target/

# Bundled Maven distribution & downloaded archive (not source)
maven/
apache-maven.zip

# Python virtual environment (helper scripts only)
.venv/

# H2 database — contains your local financial data, never commit
*.mv.db
*.trace.db
*.lock.db

# Local personal budget data — your amounts stay off git
pig-purchases-data.txt
pig-purchases-data.txt.imported
budget-import.json

# Where the *ValidationTest suite finds real statements on THIS machine. The PDFs were
# never committed; the paths to them were, hard-coded in four test files, which published
# a home directory and the institutions behind each parser. The .example IS committed.
statements.local.properties

# OS / shortcut noise
*.lnk

# Recovered DB candidates and any local db working folder — never commit financial data
/db/

# JVM crash dumps (native OOM etc.) — noise, never source
hs_err_pid*.log
replay_pid*.log

# Subagent reports — overwritten each run, superseded by the next one.
# The agent DEFINITIONS in .claude/agents/ are project config and DO get committed.
.claude/reports/

# The architecture PDF and its generator's dependencies. The PDF is BUILT, not
# tracked -- regenerate with: node docs/build/build-architecture-pdf.mjs
# To commit a copy anyway on purpose: git add -f docs/ARCHITECTURE.pdf
docs/ARCHITECTURE.pdf
docs/.architecture.print.html
docs/build/node_modules/
docs/build/package-lock.json
# Pre-move locations, kept so an older clone does not suddenly start offering these.
docs/node_modules/
docs/package-lock.json
